# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=5679

# MySQL. Use either DATABASE_URL or the separate DB_* fields below.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/AiDrama

# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=AiDrama

# Local file storage
DATA_ROOT=./data
STORAGE_PATH=./data/static

# Alipay recharge payment
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
PUBLIC_API_BASE_URL=http://localhost:5679

# Video billing. Adjust with backend script:
# VIDEO_PRICE_PER_SECOND=1.00

# AI text per-call timeout in ms (undici headers/body). Default 180000 (3 min).
# Must stay BELOW the serverless function timeout (SCF is 900s) so a stalled
# model call fails fast with a real error instead of a silent platform kill.
# AI_REQUEST_TIMEOUT_MS=180000

# Hard total deadline for one storyboard chunk's multi-step generation, in ms.
# Default 600000 (10 min); also keep below the SCF 900s function timeout.
# STORYBOARD_CHUNK_TIMEOUT_MS=600000

# Optional Tencent COS upload/proxy support
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=

# Optional Tencent Cloud SMS verification for registration.
# When these are absent outside production, /api/v1/auth/sms-code returns dev_code for local testing.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# Also supported for compatibility with the Drama project:
# TENCENT_REGION=ap-guangzhou
# SMS_SDK_APP_ID=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_ID=
