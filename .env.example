# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=5679

# MySQL. Use either DATABASE_URL or the separate DB_* fields below.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/AiDrama

# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=AiDrama

# Local file storage
DATA_ROOT=./data
STORAGE_PATH=./data/static

# AI text request timeout in ms (headers/body). Default 900000 (15 min).
# Raise this if slow models (e.g. storyboard breakdown) hit "Headers Timeout Error".
# AI_REQUEST_TIMEOUT_MS=900000

# Optional Tencent COS upload/proxy support
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=
