#!/bin/bash

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"

export NODE_ENV=production
export PORT="${PORT:-9000}"
export HOST="${HOST:-0.0.0.0}"
export FRONTEND_PUBLIC_PATH="${FRONTEND_PUBLIC_PATH:-$ROOT_DIR/public}"
export DATA_ROOT="${DATA_ROOT:-/tmp/aidrama}"
export STORAGE_PATH="${STORAGE_PATH:-/tmp/aidrama/static}"

mkdir -p "$STORAGE_PATH"

cd "$ROOT_DIR/backend"
NODE_BIN="${NODE_BIN:-/var/lang/node20/bin/node}"
if [ ! -x "$NODE_BIN" ] && [ -x "/var/lang/node18/bin/node" ]; then
  NODE_BIN="/var/lang/node18/bin/node"
fi
if [ ! -x "$NODE_BIN" ]; then
  NODE_BIN="$(command -v node)"
fi

exec "$NODE_BIN" dist/server.js
